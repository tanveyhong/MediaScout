{
  "manifest_version": 3,
  "name": "Media Scout Companion",
  "version": "0.7.1",
  "description": "Resolve supported public Instagram, YouTube, Bilibili, Douyin, and Re:ANIME videos through Media Scout.",
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.bilibili.com/*",
    "https://*.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.bytefcdn.com/*",
    "https://*.amemv.com/*",
    "https://*.snssdk.com/*",
    "https://*.pstatp.com/*",
    "https://*.volccdn.com/*",
    "https://*.zjcdn.com/*",
    "https://reanime.to/*",
    "https://*.reanime.to/*",
    "https://flixcloud.cc/*",
    "https://*.flixcloud.cc/*",
    "http://127.0.0.1:48731/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://flixcloud.cc/*", "https://*.flixcloud.cc/*"],
      "js": ["player-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.bilibili.com/*",
        "https://*.douyin.com/*",
        "https://reanime.to/*",
        "https://*.reanime.to/*",
        "https://flixcloud.cc/*",
        "https://*.flixcloud.cc/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Media Scout Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
