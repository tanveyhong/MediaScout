{
  "name": "media-scout",
  "productName": "Media Scout",
  "version": "0.7.7",
  "description": "Detect and save authorized direct media files from an in-app browser.",
  "main": "src/main.js",
  "author": "Independent Developer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:local": "node scripts/run-local-fixture.js",
    "lint": "eslint src scripts test browser-extension",
    "format": "prettier --write \"{src,scripts,test,browser-extension}/**/*.{js,css,html,json}\" \"*.{json,md,yaml}\"",
    "format:check": "prettier --check \"{src,scripts,test,browser-extension}/**/*.{js,css,html,json}\" \"*.{json,md,yaml}\"",
    "verify": "node scripts/verify.js",
    "pack": "electron-builder --dir",
    "pack:extension": "node scripts/package-extension.js",
    "release:ci": "electron-builder --win nsis --publish never",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "archiver": "^8.0.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "com.independent.mediascout",
    "productName": "Media Scout",
    "artifactName": "Media-Scout-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "browser-extension/**/*",
      "node_modules/@distube/yt-dlp/bin/*.exe",
      "node_modules/ffmpeg-static/*.exe"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "browser-extension/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "tanveyhong",
      "repo": "MediaScout"
    },
    "win": {
      "icon": "assets/media-scout.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/media-scout.ico",
      "uninstallerIcon": "assets/media-scout.ico",
      "installerHeaderIcon": "assets/media-scout.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@distube/yt-dlp": "^2.0.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  }
}
