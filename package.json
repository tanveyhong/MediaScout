{
  "name": "media-scout",
  "version": "0.2.10",
  "description": "Detect and save authorized direct media files from an in-app browser.",
  "main": "src/main.js",
  "author": "Independent Developer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "test:local": "node scripts/run-local-fixture.js",
    "verify": "node scripts/verify.js",
    "pack": "electron-builder --dir",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.independent.mediascout",
    "productName": "Media Scout",
    "asar": true,
    "asarUnpack": [
      "node_modules/@distube/yt-dlp/bin/*.exe",
      "node_modules/ffmpeg-static/*.exe"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "browser-extension/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/media-scout.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/media-scout.ico",
      "uninstallerIcon": "assets/media-scout.ico",
      "installerHeaderIcon": "assets/media-scout.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@distube/yt-dlp": "^2.0.1",
    "ffmpeg-static": "^5.3.0"
  }
}
